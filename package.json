{
  "name": "cypress-orangehrm-sanbercode",
  "version": "1.0.0",
  "description": "Automated End-to-End Testing for OrangeHRM Login Feature using Cypress - SanberCode QA Automation",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:quiz3": "cypress run --spec cypress/e2e/login_orangehrm.cy.js",
    "cypress:run:intercept": "cypress run --spec cypress/e2e/intercept/login_intercept.cy.js",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:headed": "cypress run --headed",
    "test": "npm run cypress:run:intercept"
  },
  "keywords": [
    "cypress",
    "quality-assurance",
    "orangehrm",
    "automation-testing",
    "sanbercode",
    "e2e-testing"
  ],
  "author": "Wiryawan Pranawadigda",
  "license": "MIT",
  "devDependencies": {
    "cypress": "^15.20.1"
  }
}
