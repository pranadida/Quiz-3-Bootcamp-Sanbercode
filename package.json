{
  "name": "cypress-orangehrm-sanbercode",
  "version": "1.0.0",
  "description": "Automated End-to-End Testing for OrangeHRM (Login, Directory, Recruitment) using Cypress & POM - SanberCode QA Automation",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:login": "cypress run --spec cypress/e2e/login.cy.js",
    "cypress:run:directory": "cypress run --spec cypress/e2e/directory.cy.js",
    "cypress:run:recruitment": "cypress run --spec cypress/e2e/recruitment.cy.js",
    "cypress:run:all": "cypress run",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:headed": "cypress run --headed",
    "test": "cypress run"
  },
  "keywords": [
    "cypress",
    "quality-assurance",
    "orangehrm",
    "automation-testing",
    "sanbercode",
    "pom",
    "e2e-testing"
  ],
  "author": "Wiryawan Pranawadigda",
  "license": "MIT",
  "devDependencies": {
    "cypress": "^15.20.1"
  }
}
